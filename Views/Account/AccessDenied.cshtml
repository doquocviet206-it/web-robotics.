@{
    ViewData["Title"] = "Không có quyền truy cập - RoboLab";
}

<div class="container py-5">
    <div class="card bg-dark-card border-secondary rounded-4 p-5 text-center mx-auto" style="max-width: 560px;">
        <i class="bi bi-shield-lock fs-1 text-warning mb-3"></i>
        <h1 class="h3 fw-bold text-light mb-2">Không có quyền truy cập</h1>
