<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phòng Thí Nghiệm Robotics & Trí Tuệ Nhân Tạo (RoboLab)</title>
    
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- KaTeX for Math Equations -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    
    <!-- Custom site styling -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/refinement.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light d-flex flex-column min-vh-100">
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>
    <!-- Navbar Header -->
    <header class="sticky-top border-bottom border-secondary-subtle header-glass">
        <nav class="navbar navbar-expand-xxl navbar-dark py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 text-gradient" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-box">
                        <i class="bi bi-cpu-fill"></i>
                    </span>
                    <span>Robo<span class="text-cyan">Lab</span></span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-xs ms-1">RESEARCH LAB</span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear-wide-connected me-1"></i> Dự án
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-secondary">
                                <li><a class="dropdown-item" asp-controller="Projects" asp-action="Index"><i class="bi bi-grid me-2 text-info"></i>Tất cả dự án</a></li>
                                <li><a class="dropdown-item" asp-controller="Projects" asp-action="Completed"><i class="bi bi-patch-check-fill me-2 text-success"></i>Sản phẩm đã hoàn thành</a></li>
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li><a class="dropdown-item" asp-controller="Projects" asp-action="Index" asp-route-category="Autonomous Mobile Robot"><i class="bi bi-truck me-2 text-warning"></i>Robot tự hành (AMR)</a></li>
                                <li><a class="dropdown-item" asp-controller="Projects" asp-action="Index" asp-route-category="Manipulator"><i class="bi bi-tools me-2 text-primary"></i>Cánh tay Robot (7-DoF)</a></li>
                                <li><a class="dropdown-item" asp-controller="Projects" asp-action="Index" asp-route-category="Quadruped"><i class="bi bi-activity me-2 text-danger"></i>Robot bốn chân & Hình người</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Knowledge" ? "active" : "")" asp-controller="Knowledge" asp-action="Index">
                                <i class="bi bi-journal-code me-1"></i> Kiến thức
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Research" ? "active" : "")" asp-controller="Research" asp-action="Index">
                                <i class="bi bi-mortarboard me-1"></i> Nghiên cứu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Docs" ? "active" : "")" asp-controller="Docs" asp-action="Index">
                                <i class="bi bi-folder-symlink me-1"></i> Tài liệu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "active" : "")" asp-controller="Members" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Thành viên
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> Về Lab
                            </a>
                        </li>
                    </ul>
                    
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <!-- Quick Search Form -->
                        <form class="d-flex position-relative me-2" asp-controller="Search" asp-action="Index" method="get">
                            <input class="form-control form-control-sm bg-darker text-light border-secondary pe-5 rounded-pill search-input" 
                                   type="search" name="q" placeholder="Tra cứu kiến thức, robot..." aria-label="Tìm kiếm nội dung" />
                            <button class="btn btn-sm text-secondary position-absolute end-0 top-50 translate-middle-y me-1 border-0" type="submit">
                                <i class="bi bi-search text-cyan" aria-hidden="true"></i><span class="visually-hidden">Tìm kiếm</span>
                            </button>
                        </form>

                        <button class="btn btn-sm btn-outline-cyan rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#aiAssistantModal">
                            <i class="bi bi-robot me-1"></i> Trợ lý AI
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <main id="main-content" role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- AI Robotics Assistant Modal Floating Button -->
    <button class="btn btn-cyan btn-float-ai shadow-lg rounded-circle" data-bs-toggle="modal" data-bs-target="#aiAssistantModal" title="Hỏi Trợ lý AI Robotics">
        <i class="bi bi-robot fs-4"></i>
        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
            <span class="visually-hidden">New alert</span>
        </span>
    </button>

    <!-- AI Assistant Modal Dialog -->
    <div class="modal fade" id="aiAssistantModal" tabindex="-1" aria-labelledby="aiAssistantModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content bg-dark border-secondary shadow-2xl">
                <div class="modal-header border-secondary bg-darker py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="brand-icon-box bg-cyan-subtle text-cyan">
                            <i class="bi bi-robot"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-light mb-0" id="aiAssistantModalLabel">Trợ Lý Thông Minh Robotics Lab</h5>
                            <small class="text-secondary fs-xs">Hỗ trợ tra cứu kiến thức Robot, thuật toán SLAM, ROS 2, FOC & thông tin dự án</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3 bg-dark-canvas" id="chatMessagesContainer" style="min-height: 380px; max-height: 480px; overflow-y: auto;">
                    <!-- Default Welcome Bot Message -->
                    <div class="chat-message bot mb-3">
                        <div class="d-flex align-items-start gap-2">
                            <div class="avatar-badge bg-info text-dark fw-bold rounded-circle"><i class="bi bi-cpu"></i></div>
                            <div class="message-bubble bg-darker border border-secondary p-3 rounded-4 shadow-sm text-light">
                                <p class="mb-1 fw-medium text-cyan">Xin chào! Tôi là Trợ lý AI của Robotics Lab.</p>
                                <p class="mb-2 text-secondary-emphasis fs-sm">Tôi có thể giải đáp nhanh mọi thắc mắc của bạn về lý thuyết Robot (ROS 2, SLAM, FOC, Động học Inverse Kinematics), thông số các sản phẩm của Lab hoặc hướng dẫn tải tài liệu.</p>
                                <div class="mt-2 pt-2 border-top border-secondary">
                                    <div class="fs-xs text-muted mb-2"><i class="bi bi-lightbulb me-1"></i>Câu hỏi gợi ý:</div>
                                    <div class="d-flex flex-wrap gap-1">
                                        <button class="btn btn-xs btn-outline-secondary quick-chip" onclick="askPresetQuestion('Kiến trúc ROS 2 có gì mới so với ROS 1?')">Kiến trúc ROS 2</button>
                                        <button class="btn btn-xs btn-outline-secondary quick-chip" onclick="askPresetQuestion('Nguyên lý hoạt động của thuật toán SLAM')">Nguyên lý SLAM</button>
                                        <button class="btn btn-xs btn-outline-secondary quick-chip" onclick="askPresetQuestion('Thông số xe tự hành AeroBot-AMR 500')">AeroBot-AMR 500</button>
                                        <button class="btn btn-xs btn-outline-secondary quick-chip" onclick="askPresetQuestion('Điều khiển FOC động cơ BLDC')">Kỹ thuật FOC</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary bg-darker p-3">
                    <form id="chatForm" class="w-100 d-flex gap-2" onsubmit="sendChatMessage(event)">
                        <input type="text" id="chatInput" aria-label="Câu hỏi cho trợ lý" class="form-control bg-dark border-secondary text-light rounded-pill px-3" placeholder="Nhập câu hỏi kỹ thuật hoặc tra cứu thông tin lab..." autocomplete="off">
                        <button type="submit" class="btn btn-cyan rounded-pill px-4 fw-semibold" id="chatSendBtn">
                            <i class="bi bi-send-fill me-1"></i> Gửi
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-top border-secondary-subtle bg-darker pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 fw-bold fs-4 text-gradient mb-3">
                        <span class="brand-icon-box">
                            <i class="bi bi-cpu-fill"></i>
                        </span>
                        <span>Robo<span class="text-cyan">Lab</span></span>
                    </div>
                    <p class="text-secondary fs-sm leading-relaxed mb-3">
                        Phòng Thí Nghiệm Nghiên Cứu & Phát Triển Robotics Tiên Tiến. Tiên phong phát triển các hệ thống Robot tự hành (AMR), cánh tay thao tác thông minh, robot phỏng sinh học và ứng dụng AI Vision trong công nghiệp hiện đại.
                    </p>
                    <div class="d-flex gap-2 text-secondary fs-5">
                        <a href="#" class="social-icon" title="GitHub"><i class="bi bi-github"></i></a>
                        <a href="#" class="social-icon" title="IEEE Xplore"><i class="bi bi-journal-bookmark-fill"></i></a>
                        <a href="#" class="social-icon" title="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="social-icon" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-light fw-bold mb-3 border-start border-2 border-cyan ps-2">Dự Án & Sản Phẩm</h6>
                    <ul class="list-unstyled fs-sm space-y-2">
                        <li><a class="footer-link" asp-controller="Projects" asp-action="Completed">Sản phẩm hoàn thành</a></li>
                        <li><a class="footer-link" asp-controller="Projects" asp-action="Detail" asp-route-id="aerobot-amr-500">AeroBot-AMR 500</a></li>
                        <li><a class="footer-link" asp-controller="Projects" asp-action="Detail" asp-route-id="cyberarm-7dof">CyberArm 7-DoF</a></li>
                        <li><a class="footer-link" asp-controller="Projects" asp-action="Detail" asp-route-id="quadro-titan">Robot Quadro-Titan</a></li>
                        <li><a class="footer-link" asp-controller="Projects" asp-action="Detail" asp-route-id="nexushumanoid">Nexus Humanoid</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="text-light fw-bold mb-3 border-start border-2 border-cyan ps-2">Kiến Thức & Nghiên Cứu</h6>
                    <ul class="list-unstyled fs-sm space-y-2">
                        <li><a class="footer-link" asp-controller="Knowledge" asp-action="Index" asp-route-category="ROS">Kiến trúc ROS 2</a></li>
                        <li><a class="footer-link" asp-controller="Knowledge" asp-action="Index" asp-route-category="SLAM">Thuật toán SLAM</a></li>
                        <li><a class="footer-link" asp-controller="Knowledge" asp-action="Index" asp-route-category="Điều khiển">Động học & Inverse Kinematics</a></li>
                        <li><a class="footer-link" asp-controller="Knowledge" asp-action="Index" asp-route-category="AI">AI Vision & Bin-Picking</a></li>
                        <li><a class="footer-link" asp-controller="Research" asp-action="Index">Công bố IEEE / ISI</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-light fw-bold mb-3 border-start border-2 border-cyan ps-2">Thông Tin Liên Hệ</h6>
                    <ul class="list-unstyled fs-sm text-secondary space-y-2">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt-fill text-cyan mt-1"></i>
                            <span>Tòa nhà Công nghệ cao R&D, Khu Đô thị Đại học, TP. Hà Nội / TP. Hồ Chí Minh</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-cyan"></i>
                            <span>contact@robotics-lab.edu.vn</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-fill text-cyan"></i>
                            <span>(+84) 024-3869-ROBO (7626)</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-fill text-cyan"></i>
                            <span>Thứ Hai - Thứ Bảy: 08:00 - 18:00</span>
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary mb-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center fs-xs text-secondary">
                <div>&copy; 2026 Advanced Robotics & AI Research Laboratory (RoboLab). All Rights Reserved.</div>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="About" class="footer-link">Giới thiệu</a>
                    <a asp-controller="Docs" asp-action="Index" class="footer-link">Quy chuẩn An toàn (SOP)</a>
                    <a asp-controller="Home" asp-action="Contact" class="footer-link">Hợp tác Doanh nghiệp</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap & KaTeX Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js" 
            onload="renderMathInElement(document.body);"></script>

    <!-- Custom Chatbot & Interaction JS -->
    <script>
        function askPresetQuestion(text) {
            document.getElementById('chatInput').value = text;
            sendChatMessage();
        }

        async function sendChatMessage(e) {
            if (e) e.preventDefault();
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message) return;

            const container = document.getElementById('chatMessagesContainer');
            
            // Append User message
            const userHtml = `
                <div class="chat-message user mb-3 text-end">
                    <div class="d-inline-block bg-primary text-light px-3 py-2 rounded-4 text-start shadow-sm" style="max-width: 80%;">
                        <div class="fw-semibold fs-xs text-white-50 mb-1"><i class="bi bi-person me-1"></i>Bạn</div>
                        <div>${escapeHtml(message)}</div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', userHtml);
            input.value = '';
            container.scrollTop = container.scrollHeight;

            // Loading state
            const loadingId = 'loading-' + Date.now();
            const loadingHtml = `
                <div class="chat-message bot mb-3" id="${loadingId}">
                    <div class="d-flex align-items-center gap-2 text-secondary fs-sm">
                        <div class="spinner-border spinner-border-sm text-cyan" role="status"></div>
                        <span>Đang tra cứu cơ sở dữ liệu Robotics...</span>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', loadingHtml);
            container.scrollTop = container.scrollHeight;

            try {
                const response = await fetch('/Search/Chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                
                const data = await response.json();
                document.getElementById(loadingId)?.remove();

                let linksHtml = '';
                if (data.relatedLinks && data.relatedLinks.length > 0) {
                    linksHtml = '<div class="mt-2 pt-2 border-top border-secondary fs-xs"><strong>Liên kết liên quan:</strong><ul class="list-unstyled mb-0 mt-1">';
                    data.relatedLinks.forEach(link => {
                        linksHtml += `<li><a href="${link}" class="text-cyan text-decoration-none"><i class="bi bi-arrow-right-circle me-1"></i>${link}</a></li>`;
                    });
                    linksHtml += '</ul></div>';
                }

                let suggestionsHtml = '';
                if (data.suggestions && data.suggestions.length > 0) {
                    suggestionsHtml = '<div class="mt-2 pt-2 border-top border-secondary"><div class="fs-xs text-muted mb-1">Gợi ý câu hỏi tiếp theo:</div><div class="d-flex flex-wrap gap-1">';
                    data.suggestions.forEach(s => {
                        suggestionsHtml += `<button class="btn btn-xs btn-outline-secondary quick-chip" onclick="askPresetQuestion('${escapeJsString(s)}')">${escapeHtml(s)}</button>`;
                    });
                    suggestionsHtml += '</div></div>';
                }

                const botHtml = `
                    <div class="chat-message bot mb-3">
                        <div class="d-flex align-items-start gap-2">
                            <div class="avatar-badge bg-info text-dark fw-bold rounded-circle"><i class="bi bi-cpu"></i></div>
                            <div class="message-bubble bg-darker border border-secondary p-3 rounded-4 shadow-sm text-light" style="max-width: 88%;">
                                <div class="fw-semibold text-cyan fs-xs mb-1">RoboLab AI Assistant</div>
                                <div class="message-content leading-relaxed fs-sm">${formatMarkdownText(data.reply)}</div>
                                ${linksHtml}
                                ${suggestionsHtml}
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', botHtml);
                container.scrollTop = container.scrollHeight;

                if (window.renderMathInElement) {
                    renderMathInElement(container);
                }
            } catch (err) {
                document.getElementById(loadingId)?.remove();
                const errorHtml = `
                    <div class="chat-message bot mb-3 text-danger fs-sm">
                        <i class="bi bi-exclamation-triangle me-1"></i> Không thể kết nối tới dịch vụ trợ lý. Vui lòng thử lại sau!
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', errorHtml);
                container.scrollTop = container.scrollHeight;
            }
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        function escapeJsString(str) {
            return str.replace(/'/g, "\\'");
        }

        function formatMarkdownText(text) {
            if (!text) return '';
            // Basic bold and list handling
            let formatted = text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/\n\n/g, '<br/><br/>')
                .replace(/\n- /g, '<br/>• ');
            return formatted;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

