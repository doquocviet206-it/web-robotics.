@model List<web_robotics.Models.LabDocGuide>
@{
    ViewData["Title"] = "Tài Liệu Hướng Dẫn & Quy Chuẩn Phòng Thí Nghiệm (SOP)";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <span class="badge bg-cyan-subtle text-cyan border border-info-subtle px-3 py-1 rounded-pill mb-2">Tài Liệu Kỹ Thuật &amp; Quy Chuẩn SOP</span>
            <h1 class="display-6 fw-bold text-light mb-1">Tài Liệu Hướng Dẫn Kỹ Thuật &amp; Dữ Liệu Mở</h1>
            <p class="text-secondary fs-sm mb-0">Thông tin giới thiệu phòng thí nghiệm, sổ tay an toàn (SOP), hướng dẫn cấu hình phần cứng, tài liệu API và tập dữ liệu mở</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a href="#quickSop" class="btn btn-outline-warning rounded-pill px-3">
                <i class="bi bi-shield-exclamation me-1"></i> Xem Quy Chuẩn An Toàn Lab (SOP)
            </a>
        </div>
    </div>

    <!-- Category filter buttons -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Index" class="btn btn-sm @(ViewBag.CurrentCategory == "All" ? "btn-cyan" : "btn-outline-secondary") rounded-pill">Tất cả tài liệu</a>
        <a asp-action="Index" asp-route-category="SOP" class="btn btn-sm @(ViewBag.CurrentCategory?.ToString().Contains("SOP") == true ? "btn-cyan" : "btn-outline-secondary") rounded-pill">Quy chuẩn An toàn (SOP)</a>
        <a asp-action="Index" asp-route-category="Setup" class="btn btn-sm @(ViewBag.CurrentCategory?.ToString().Contains("Setup") == true ? "btn-cyan" : "btn-outline-secondary") rounded-pill">Hướng dẫn cài đặt</a>
        <a asp-action="Index" asp-route-category="Hardware" class="btn btn-sm @(ViewBag.CurrentCategory?.ToString().Contains("Hardware") == true ? "btn-cyan" : "btn-outline-secondary") rounded-pill">Sơ đồ phần cứng</a>
        <a asp-action="Index" asp-route-category="Dataset" class="btn btn-sm @(ViewBag.CurrentCategory?.ToString().Contains("Dataset") == true ? "btn-cyan" : "btn-outline-secondary") rounded-pill">Dữ liệu mở</a>
        <a asp-action="Index" asp-route-category="API" class="btn btn-sm @(ViewBag.CurrentCategory?.ToString().Contains("API") == true ? "btn-cyan" : "btn-outline-secondary") rounded-pill">Tài liệu API &amp; SDK</a>
    </div>

    <!-- Docs Cards Grid -->
    <div class="row g-4 mb-5">
        @foreach (var doc in Model)
        {
            <div class="col-lg-6">
                <div class="card h-100 bg-dark-card border-secondary rounded-4 p-4 shadow-sm card-hover-effect d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@doc.Category</span>
                        <span class="badge bg-secondary-subtle text-info font-mono">@doc.Version</span>
                    </div>

                    <h4 class="fw-bold text-light mb-2 lh-base">@doc.Title</h4>
                    <p class="text-secondary fs-sm leading-relaxed flex-grow-1">@doc.Description</p>

                    <div class="bg-darker p-3 rounded-3 border border-secondary-subtle mb-3 fs-xs">
                        <div class="d-flex justify-content-between text-muted mb-1">
                            <span>Đối tượng áp dụng:</span>
                            <span class="text-light fw-medium">@doc.TargetAudience</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted">
                            <span>Kích thước file / Định dạng:</span>
                            <span class="text-cyan font-mono">@doc.FileSize</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary mt-auto">
                        <span class="fs-xs text-success"><i class="bi bi-shield-check me-1"></i>Đã phê duyệt 2026</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="alert('Bắt đầu tải xuống: @doc.Title');">
                                <i class="bi bi-download me-1"></i> Tải về
                            </button>
                            <button class="btn btn-sm btn-cyan rounded-pill px-3" onclick="askPresetQuestion('Tóm tắt nội dung tài liệu @doc.Title')">
                                <i class="bi bi-robot me-1"></i> Xem tóm tắt
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Standard Operating Procedure (SOP) Highlight Box -->
    <div class="card bg-darker border-warning border-2 rounded-4 p-4 p-md-5 shadow-lg" id="quickSop">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="brand-icon-box bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <h4 class="fw-bold text-light mb-0">Tóm Tắt 4 Quy Định An Toàn Bắt Buộc Tại Phòng Lab Robotics</h4>
                <small class="text-warning">Mọi thành viên và khách tham quan cần nắm vững trước khi tiếp xúc trạm thử nghiệm</small>
            </div>
        </div>

        <div class="row g-3 fs-sm text-secondary leading-relaxed mt-2">
            <div class="col-md-6">
                <div class="p-3 bg-dark-card border border-secondary rounded-3">
                    <strong class="text-light d-block mb-1">1. Khu vực hoạt động cánh tay Robot công nghiệp (Manipulator Area)</strong>
                    Tuyệt đối không bước qua vạch kẻ an toàn màu vàng khi đèn tháp tín hiệu chuyển sang màu đỏ hoặc xanh lá cây đang chuyển động. Luôn cầm tay cầm dừng khẩn cấp (E-Stop Pendant) khi chạy chương trình mới.
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-dark-card border border-secondary rounded-3">
                    <strong class="text-light d-block mb-1">2. Thử nghiệm Xe tự hành (AMR Test Track)</strong>
                    Đảm bảo cảm biến Laser Scanner không bị che khuất bởi bụi bẩn hoặc băng dính. Khi thử nghiệm tốc độ cao trên 1.5 m/s, bắt buộc phải có ít nhất 2 kỹ sư giám sát với nút dừng từ xa qua mạng sóng RF.
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-dark-card border border-secondary rounded-3">
                    <strong class="text-light d-block mb-1">3. Quản lý Pin LiPo / LiFePO4 dung lượng lớn</strong>
                    Toàn bộ pin sạc cho robot bốn chân và drone phải được nạp trong tủ chống cháy chuyên dụng. Ngắt nguồn ngay lập tức nếu phát hiện hiện tượng phồng pin hoặc nhiệt độ vượt quá 60°C.
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-dark-card border border-secondary rounded-3">
                    <strong class="text-light d-block mb-1">4. Trang thiết bị bảo hộ cá nhân (PPE)</strong>
                    Bắt buộc mang kính bảo hộ khi thử nghiệm cơ cấu cắt/phay cơ khí hoặc khi thử động cơ quay tốc độ cao (trên 3,000 RPM). Không mặc trang phục có dây thả lòng thòng gần trục truyền động.
                </div>
            </div>
        </div>
    </div>
</div>
